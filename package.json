{
    "name": "lightyear-monorepo",
    "private": true,
    "scripts": {
        "dev:web": "cd web && bun run dev",
        "dev:server": "go run ./server/cmd/api",
        "build:web": "cd web && bun run build",
        "build:compute": "cargo build --workspace --release",
        "build:worker": "cargo build -p compute-worker --release",
        "check:web": "cd web && bunx nuxt typecheck",
        "test:web": "cd web && bunx nuxt typecheck",
        "test:server": "go test ./server/...",
        "test:compute": "cargo test --workspace",
        "benchmark": "bun run ./scripts/benchmark.ts",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "prepare": "cd web && bun run postinstall"
    },
    "workspaces": [
        "web"
    ],
    "overrides": {
        "unimport": "^6.1.1"
    },
    "engines": {
        "bun": ">=1.0.0"
    },
    "devDependencies": {
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "vitepress": "^1.6.4"
    }
}