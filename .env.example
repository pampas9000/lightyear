APP_ENV=
SERVER_ADDR=
PORT=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
AUTO_MIGRATE=
FRONTEND_URL=

S3_ENDPOINT=
S3_ACCESS_ID=
S3_ACCESS_KEY=
S3_BUCKET=
# Empty means "auto" (R2)
S3_REGION=
# Days to keep source files and outputs before the lifecycle sweep removes
# them (default 30; 0 keeps them forever)
SOURCE_RETENTION_DAYS=
OUTPUT_RETENTION_DAYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Orchestrator limits (optional; defaults shown)
# DISPATCH_MAX_PROCESSING_PER_USER=8
# EXECUTION_LIMIT=10m
# TARGET_EXECUTION_LIMIT=30m

# Rust worker limits (optional)
# WORKER_MAX_SOURCE_BYTES=209715200
# URL sources: extra networks the worker may fetch from, comma-separated CIDRs.
# Empty (default) allows public addresses only; `task dev` sets 127.0.0.0/8.
# WORKER_FETCH_ALLOW_CIDRS=
# WORKER_FETCH_CONNECT_TIMEOUT_SECS=10
# WORKER_FETCH_READ_TIMEOUT_SECS=30
# WORKER_MAX_PIXELS=100000000
# AVIF encoder: libavif (default) or libvips (fallback, same as the browser sandbox)
# WORKER_AVIF_ENCODER=libavif
